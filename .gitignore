# ami_automation .gitignore
# Generated files and temporary data

# Packer generated files
laboratory/*/packer-manifest.json
laboratory/*/.packer/

# Packer cache
packer_cache/
*.box

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.*.swp
.*.swo

# Temporary files
tmp/
temp/
*.tmp

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
ENV/
*.egg-info/
.eggs/

# Test results
test-results/
coverage/
.pytest_cache/
.coverage
htmlcov/

# Don't ignore .gitkeep files
!.gitkeep